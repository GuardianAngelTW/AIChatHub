<?xml version="1.0" encoding="utf-8"?>
<!-- 允許 HTTP 明文，以便連線區域網路內的 Ollama / LM Studio 等本地模型。
     雲端服務一律使用 HTTPS。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
